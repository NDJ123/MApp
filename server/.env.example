# =============================================================================
# SERVER ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git - it contains secrets!
# =============================================================================

# Server Configuration
# --------------------
NODE_ENV=development          # 'development' or 'production'
PORT=5000                     # Port the server runs on

# MongoDB Connection
# ------------------
# Local: mongodb://localhost:27017/mapp
# Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/mapp
MONGO_URI=mongodb://localhost:27017/mapp

# JWT Authentication
# ------------------
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d                 # Token expiration (7 days)

# Email Configuration (for password reset)
# ----------------------------------------
# For Gmail, you need an "App Password" - not your regular password
# Go to: Google Account > Security > 2-Step Verification > App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL (for CORS and email links)
# ---------------------------------------
CLIENT_URL=http://localhost:5173
