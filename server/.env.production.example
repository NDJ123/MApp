# =============================================================================
# SERVER ENVIRONMENT VARIABLES - PRODUCTION
# =============================================================================
# Set these in your deployment platform (Render, Railway, etc.)
# NEVER commit actual production values to git!
# =============================================================================

# Server Configuration
NODE_ENV=production
PORT=5001

# MongoDB Connection (use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/mapp

# JWT Authentication
# IMPORTANT: Generate a strong secret for production!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-byte-hex-string-for-production
JWT_EXPIRE=7d

# Email Configuration (optional - for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL (your deployed frontend domain)
# This is used for CORS - must match exactly!
# Example: https://mapp.yourdomain.com or https://mapp.vercel.app
CLIENT_URL=https://your-frontend-domain.com
